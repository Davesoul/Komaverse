APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,https://tauri.localhost

# Auth is always on (local users + sessions); no bypass switch.
# Billing (credits enforced when true)
PAYWALL_ENABLED=false

# AI (AI_PROVIDER: cloud | meta | openrouter | comfyui | fake)
AI_PROVIDER=cloud
AI_BASE_URL=
AI_API_KEY=
AI_IMAGE_MODEL=image
AI_CHAT_MODEL=gpt-4o-mini
AI_VISION_MODEL=
# Meta Muse agent brain (https://api.meta.ai/v1, OpenAI-compatible)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_CHAT_MODEL=muse-spark-1.3
META_VISION_MODEL=
# OpenRouter images + async video (one key; video costs real credits)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-3-image-klein
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0
OPENROUTER_REFERER=https://komaverse.studio
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CKPT=model.safetensors
COMFYUI_SEED=1
COMFYUI_TIMEOUT_SEC=180

# Data (M2)
DATABASE_URL=sqlite:///./komaverse.db
REDIS_URL=redis://localhost:6379/0

# Limits
UPLOAD_MAX_MB=50
PROJECT_QUOTA_MB=500
RATE_LIMIT_PER_MINUTE=1000

# Panel detection (YOLO local model; absolute or backend-root-relative)
KOMA_YOLO_MODEL=models/best-comic-panel-detection.pt
# Smaller/faster alternative: models/leoxs22_yolo26n_panel_detector.pt
