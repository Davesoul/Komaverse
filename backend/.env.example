APP_ENV=development
# Demo sign-in for judges (demo@komaverse.local / demo1234, see README).
# Set false on public deploys that must not carry a known-password account.
KOMA_SEED_DEMO=true
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,https://tauri.localhost

# Auth is always on (local users + sessions); no bypass switch.
# Billing (credits enforced when true). See docs/BILLING.md.
PAYWALL_ENABLED=false
# Koma Portal top-ups (Stripe). Empty = checkout/webhook answer 503,
# the studio keeps running on freemium. APP_URL must be the public URL
# so Stripe can redirect back to /portal after payment.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:5173
FREE_MONTHLY_CREDITS=100
# Bring-your-own-key vault (per-user provider keys, Fernet-encrypted).
# Empty = users cannot save own keys (503 with the fix). Generate once:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_VAULT_SECRET=
# Own-key freemium guardrail: paid subscribers generate unlimited on
# their own keys; freemium own-key users stop here per calendar day.
OWN_KEY_FREEMIUM_DAILY_LIMIT=20

# AI (AI_PROVIDER: cloud | meta | local | openrouter | comfyui | fake)
AI_PROVIDER=cloud
AI_BASE_URL=
AI_API_KEY=
AI_IMAGE_MODEL=image
AI_CHAT_MODEL=gpt-4o-mini
AI_VISION_MODEL=
# Meta Muse agent brain (https://api.meta.ai/v1, OpenAI-compatible)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_CHAT_MODEL=muse-spark-1.3
META_VISION_MODEL=
META_IMAGE_MODEL=muse-image-1.0
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_SAM_MODEL=sam-3.1
# Agent drawing defaults (Brain panel Drawing section overrides hot).
# TRACE_MODE: ink|edges|bezier|a2s|mangaline|anilines|anilines-detail|linedistiller
# TRACE_DETAIL: auto|fast|fine. TRACE_THIN: true = uniform thin lines.
# TRACE_RAW: true = place the tech lineart map directly (no brush replay).
TRACE_MODE=ink
TRACE_DETAIL=auto
TRACE_THIN=true
TRACE_RAW=false
# Local open-weight server (Ollama-compatible) for desktop / on-device use:
# run `ollama pull qwen3:8b` (+ a vision model), then set the names below.
LOCAL_BASE_URL=http://127.0.0.1:11434
LOCAL_API_KEY=ollama
LOCAL_CHAT_MODEL=
LOCAL_VISION_MODEL=
LOCAL_IMAGE_MODEL=
# OpenRouter images + async video (one key; video costs real credits)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-3-image-klein
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0
OPENROUTER_REFERER=https://komaverse.studio
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CKPT=model.safetensors
COMFYUI_SEED=1
COMFYUI_TIMEOUT_SEC=180

# Data (M2): dev default is the repo-local sqlite file. Docker/prod overrides
# to sqlite:////data/komaverse.db with MEDIA_DIR=/data/media (see root
# Dockerfile + docker-compose.yml volumes). The API creates parent dirs on
# boot, so a volume-backed URL never fails on first start.
DATABASE_URL=sqlite:///./komaverse.db
REDIS_URL=redis://localhost:6379/0

# Limits
UPLOAD_MAX_MB=50
PROJECT_QUOTA_MB=500
RATE_LIMIT_PER_MINUTE=1000

# Panel detection (YOLO local model; absolute or backend-root-relative)
KOMA_YOLO_MODEL=models/best-comic-panel-detection.pt
# Optional: fetch weights on first scan when the files above are missing
# (web deploys). Empty = no download, fall back to heuristic.
KOMA_YOLO_URL=
KOMA_YOLO_LEOXS_URL=
# MCP server identity (stdio): the studio login email the agent acts as
KOMAVERSE_MCP_USER=
# Smaller/faster alternative: models/leoxs22_yolo26n_panel_detector.pt
